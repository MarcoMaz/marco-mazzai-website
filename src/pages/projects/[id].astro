---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectEntry from "../../components/templates/ProjectEntry/ProjectEntry.astro";
import { PAGE_TITLES } from "../../content.config";

type PetProjectEntry = CollectionEntry<"petProjects">;

export const getStaticPaths: () => Promise<
  {
    params: { id: string };
    props: { heading: string; description: string; imageSrc: string };
  }[]
> = async () => {
  const entries: PetProjectEntry[] = await getCollection("petProjects");

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: {
      heading: entry.data.heading,
      description: entry.data.description,
      imageSrc: entry.data.image.src,
    },
  }));
};

const { id } = Astro.params as { id: string };
const { heading, description, imageSrc } = Astro.props as {
  heading: string;
  description: string;
  imageSrc: string;
};

const pageTitle: string = `${heading} ${PAGE_TITLES.blogSuffix}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  image={imageSrc}
  type="article"
>
  <ProjectEntry id={id} />
</BaseLayout>
