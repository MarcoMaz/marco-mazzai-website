---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectIframe from "../../components/molecules/ProjectIframe/ProjectIframe.astro";
import { formatDateRange } from "../../lib/date";
import { PAGE_TITLES } from "../../content.config";
import ChipList from "../../components/molecules/ChipList/ChipList.astro";
import IconLink from "../../components/atoms/IconLink/IconLink.astro";
import { Icon } from "astro-icon/components";
import GoToEntry from "../../components/molecules/GoToEntry/GoToEntry.astro";

type PetProjectEntry = CollectionEntry<"petProjects">;

export const getStaticPaths = async () => {
  const entries: PetProjectEntry[] = await getCollection("petProjects");
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prevEntry: sorted[index - 1],
      nextEntry: sorted[index + 1],
    },
  }));
};

const { entry, prevEntry, nextEntry } = Astro.props as {
  entry: PetProjectEntry;
  prevEntry: PetProjectEntry | undefined;
  nextEntry: PetProjectEntry | undefined;
};

const { heading, kicker, description, date, chips, githubUrl, preview, image } =
  entry.data;

const pageTitle = `${heading} ${PAGE_TITLES.blogSuffix}`;

const GITHUB_LABEL: string = "Github";

const ABOUT_THE_PROJECT_TITLE: string = "About the project";
---

<BaseLayout title={pageTitle} description={description} image={image.src} type="article">
  <section class="mm-entry">
    <div class="mm-entry__date">
      {formatDateRange(date.from, date.to)}
    </div>
    <div class="mm-entry__kicker">{kicker}</div>
    <h1 class="mm-entry__heading">{heading}</h1>
    <ChipList chips={chips} />
    <div class="mm-entry__content">
      <h2 class="mm-entry__content--heading">
        {ABOUT_THE_PROJECT_TITLE}
      </h2>
      <p class="mm-entry__content--description">{description}</p>
      <IconLink href={githubUrl} target="_blank">
        {GITHUB_LABEL}
        <Icon name="ph:github-logo" slot="icon-left" />
      </IconLink>
    </div>
    {
      preview && (
        <ProjectIframe
          src={preview.url}
          title={preview.title}
          width={preview.width}
          height={preview.height}
        />
      )
    }
    <hr class="mm-entry__divider" />
    <GoToEntry
      prevEntry={prevEntry && {
        href: `/projects/${prevEntry.id}`,
        heading: prevEntry.data.heading,
        date: prevEntry.data.date,
      }}
      nextEntry={nextEntry && {
        href: `/projects/${nextEntry.id}`,
        heading: nextEntry.data.heading,
        date: nextEntry.data.date,
      }}
    />
  </section>
</BaseLayout>
