---
import { PAGE_TITLES } from "../../content.config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogEntry from "../../components/organisms/BlogEntry/BlogEntry.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type BlogPost = CollectionEntry<"blog">;

export const getStaticPaths: () => Promise<
  {
    params: { slug: string };
    props: { heading: string; kicker: string };
  }[]
> = async () => {
  const posts: BlogPost[] = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { heading: post.data.heading, kicker: post.data.kicker },
  }));
};

const { slug } = Astro.params as { slug: string };
const { heading, kicker } = Astro.props as { heading: string; kicker: string };

const blogSuffix = PAGE_TITLES.blogSuffix;
const pageTitle: string = `${heading} ${blogSuffix}`;
---

<BaseLayout title={pageTitle} description={kicker} type="article">
  <BlogEntry slug={slug} />
</BaseLayout>
