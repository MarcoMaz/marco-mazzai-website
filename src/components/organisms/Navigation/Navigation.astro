---
import { Icon } from "astro-icon/components";
import { getCollection, type CollectionEntry } from "astro:content";
import Avatar from "../../atoms/Avatar/Avatar.astro";

interface Props {
  isHome?: boolean;
}

const { isHome = true } = Astro.props;

type NavigationEntry = CollectionEntry<"navigation">;

const navigationCollection: NavigationEntry[] =
  await getCollection("navigation");

if (navigationCollection.length === 0) {
  throw new Error("Navigation not found in copy collection");
}

const { navigationItems } = navigationCollection[0].data;

const pathname = Astro.url.pathname;

const isActiveUrl = (url: string) =>
  url === "/"
    ? pathname === "/"
    : url.startsWith("/") && pathname.startsWith(url);
---

<nav aria-label="Site">
  <!-- Mobile only: avatar + hamburger, collapsible list (below desktop breakpoint) -->
  <div class="mm-navigation-mobile">
    <div class="mm-navigation-mobile__topbar">
      <Avatar />
      <button
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mm-navigation-mobile-list"
        class="mm-navigation-mobile__hamburger"
      >
        <Icon
          name="ph:list"
          size={24}
          aria-hidden="true"
          class="mm-navigation-mobile__icon-list"
        />
        <Icon
          name="ph:x"
          size={24}
          aria-hidden="true"
          class="mm-navigation-mobile__icon-x"
        />
      </button>
    </div>
    <ul id="mm-navigation-mobile-list" class="mm-navigation-mobile__list">
      {
        navigationItems.map(({ url, label }) => (
          <li class="mm-navigation-mobile__list-item">
            <a href={url} aria-current={isActiveUrl(url) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Desktop only: corner-positioned hero list (fades on scroll) + slide-in side panel -->
  <div class="mm-navigation-desktop">
    <ul class="mm-navigation-desktop__hero-list">
      {
        navigationItems.map(({ url, label }) => (
          <li class="mm-navigation-desktop__hero-list-item">
            <a href={url} aria-current={isActiveUrl(url) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class:list={["mm-navigation-desktop__side", { "--scrolled": !isHome }]}
    >
      <Avatar />
      <ul class="mm-navigation-desktop__side-list">
        {
          navigationItems.map(({ url, label }) => (
            <li class="mm-navigation-desktop__side-list-item">
              <a
                href={url}
                aria-current={isActiveUrl(url) ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    ".mm-navigation-mobile__hamburger",
  );
  const navList = document.getElementById("mm-navigation-mobile-list");

  const setOpen = (open: boolean) => {
    if (!navList || !button) return;
    navList.classList.toggle("--open", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute(
      "aria-label",
      open ? "Close navigation" : "Open navigation",
    );
    document.body.classList.toggle("blocked", open);
  };

  const MOBILE_MQ = window.matchMedia("(max-width: 1023px)");
  MOBILE_MQ.addEventListener("change", () => setOpen(false));

  button?.addEventListener("click", () => {
    setOpen(button.getAttribute("aria-expanded") !== "true");
  });

  // Trap Tab/Shift+Tab within the button + links while the menu is open, and
  // let Escape close it, so keyboard focus never lands on page content
  // hidden behind the open overlay.
  document.addEventListener("keydown", (e) => {
    if (!navList?.classList.contains("--open") || !button) return;

    if (e.key === "Escape") {
      setOpen(false);
      button.focus();
      return;
    }

    if (e.key !== "Tab") return;

    const items = [button, ...navList.querySelectorAll<HTMLAnchorElement>("a")];
    const first = items[0];
    const last = items[items.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
