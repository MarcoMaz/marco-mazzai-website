---
import "./Button.scss";
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a class:list={['mm-button', className]} href={href}
  ><slot />
  <span class='mm-button__icon'>
    <Icon name="ph:caret-right" />
  </span>
</a>
