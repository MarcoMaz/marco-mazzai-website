---
import { Icon } from "astro-icon/components";
import {
  formatDate,
  formatDateRange,
  type PartialDate,
} from "../../../lib/date";

interface EntryProps {
  href: string;
  heading: string;
  date: string | { from: PartialDate; to?: PartialDate };
}

interface GoToEntryProps {
  prevEntry?: EntryProps;
  nextEntry?: EntryProps;
}

const { prevEntry, nextEntry } = Astro.props as GoToEntryProps;

const formatEntryDate = (date: EntryProps["date"]): string =>
  typeof date === "string"
    ? formatDate(date)
    : formatDateRange(date.from, date.to);
---

<nav class="mm-go-to-entry">
  {
    prevEntry && (
      <a
        href={prevEntry.href}
        class="mm-go-to-entry__link mm-go-to-entry__link--prev"
      >
        <Icon name="ph:caret-left" />
        <div class="mm-go-to-entry__info">
          <div class="mm-go-to-entry__info--date">
            {formatEntryDate(prevEntry.date)}
          </div>
          <div class="mm-go-to-entry__info--heading">{prevEntry.heading}</div>
        </div>
      </a>
    )
  }
  {
    nextEntry && (
      <a
        href={nextEntry.href}
        class="mm-go-to-entry__link mm-go-to-entry__link--next"
      >
        <div class="mm-go-to-entry__info">
          <div class="mm-go-to-entry__info--date">
            {formatEntryDate(nextEntry.date)}
          </div>
          <div class="mm-go-to-entry__info--heading">{nextEntry.heading}</div>
        </div>
        <Icon name="ph:caret-right" />
      </a>
    )
  }
</nav>
