---
type ProjectIFrameProps = {
  height?: number;
  src: string;
  title: string;
  width?: number;
};

const {
  height = 400,
  width = 600,
  src,
  title,
} = Astro.props as ProjectIFrameProps;

if (!src) throw new Error('ProjectIframe: "src" prop is required');
---

<div class="mm-project-iframe">
  <button class="mm-project-iframe__skip" type="button"
    >Skip project preview</button
  >
  <iframe
    src={src}
    width={width}
    height={height}
    class="mm-project-iframe__frame"
    style={`--iframe-width: ${width}; --iframe-height: ${height};`}
    title={title}
    allowfullscreen></iframe>
  <button class="mm-project-iframe__skip mm-project-iframe__skip--back" type="button"
    >Skip project preview (back)</button
  >
</div>

<script>
  import { initProjectIframeSkipLinks } from "./focusTrap";

  initProjectIframeSkipLinks();
</script>
