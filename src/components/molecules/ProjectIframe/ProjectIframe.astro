---
type ProjectIFrameProps = {
  height?: number;
  src: string;
  title: string;
  width?: number;
};

const {
  height = 400,
  width = 600,
  src,
  title,
} = Astro.props as ProjectIFrameProps;

if (!src) throw new Error('ProjectIframe: "src" prop is required');
---

<div class="mm-project-iframe">
  <button class="mm-project-iframe__skip" type="button"
    >Skip project preview</button
  >
  <iframe
    src={src}
    width={width}
    height={height}
    class="mm-project-iframe__frame"
    style={`--iframe-width: ${width}; --iframe-height: ${height};`}
    title={title}
    allowfullscreen></iframe>
  <button class="mm-project-iframe__skip mm-project-iframe__skip--back" type="button"
    >Skip project preview (back)</button
  >
</div>

<script>
  const FOCUSABLE =
    'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  const skipButtons = document.querySelectorAll(
    ".mm-project-iframe__skip:not(.mm-project-iframe__skip--back)",
  ) as NodeListOf<HTMLButtonElement>;

  skipButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrapper = btn.closest(".mm-project-iframe");
      let el = wrapper?.nextElementSibling;
      while (el) {
        const target = el.matches(FOCUSABLE)
          ? (el as HTMLElement)
          : (el.querySelector(FOCUSABLE) as HTMLElement | null);
        if (target) {
          target.focus();
          return;
        }
        el = el.nextElementSibling;
      }
    });
  });

  const backButtons = document.querySelectorAll(
    ".mm-project-iframe__skip--back",
  ) as NodeListOf<HTMLButtonElement>;

  backButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrapper = btn.closest(".mm-project-iframe");
      const getAllFocusable = (root: Element) =>
        Array.from(root.querySelectorAll(FOCUSABLE)) as HTMLElement[];

      let el = wrapper?.previousElementSibling;
      let lastTarget: HTMLElement | null = null;
      while (el) {
        const candidates = el.matches(FOCUSABLE)
          ? [el as HTMLElement]
          : getAllFocusable(el);
        if (candidates.length) lastTarget = candidates[candidates.length - 1];
        if (lastTarget) break;
        el = el.previousElementSibling;
      }
      lastTarget?.focus();
    });
  });
</script>
