---
import Footer from "../components/Footer.astro";
import HeroSection from "../components/HeroSection.astro";
import Navigation from "../components/Navigation.astro";
import { PAGE_TITLES, META } from "../content.config";
import "../styles/global.scss";

interface BaseLayoutProps {
  title?: string;
}

const { title } = Astro.props as BaseLayoutProps;

const pageTitle = PAGE_TITLES.default;

const {
  keywords,
  description,
  title: metaTitle,
  og: {
    url: ogUrl,
    image: ogImage,
    type: ogType,
    description: ogDescription,
    locale: ogLocale,
  },
} = META;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <title>{title ?? pageTitle}</title>

    <!-- SEO + Social Meta -->
    <meta name="keywords" content={keywords} />
    <meta name="description" content={description} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content={ogLocale} />
  </head>
  <body>
    <Navigation />
    <HeroSection />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Toggle hero nav out and side nav in when hero scrolls out of view
      const hero = document.querySelector<HTMLElement>(".mm-hero");
      const heroNav = document.querySelector<HTMLElement>(".mm-navigation-hero");
      const sideNav = document.querySelector<HTMLElement>(".mm-navigation-side");
      const mainEl = document.querySelector<HTMLElement>("main");

      const DESKTOP_MQ = window.matchMedia("(min-width: 1024px)");

      if (hero && heroNav && sideNav && mainEl) {
        // Side nav + main shift only once the hero is completely off screen
        const observer = new IntersectionObserver(([entry]) => {
          const scrolled = !entry.isIntersecting;
          sideNav.classList.toggle("--scrolled", scrolled);
          mainEl.classList.toggle("--scrolled", scrolled);
        });
        observer.observe(hero);

        // Hero nav opacity tied 1:1 to scroll progress through the hero (desktop only)
        const updateHeroNav = () => {
          if (!DESKTOP_MQ.matches) return;
          const ratio = Math.max(0, 1 - window.scrollY / hero.offsetHeight);
          heroNav.style.transition = "none";
          heroNav.style.opacity = String(ratio);
          heroNav.style.pointerEvents = ratio > 0 ? "" : "none";
          heroNav.style.visibility = ratio > 0 ? "" : "hidden";
        };
        window.addEventListener("scroll", updateHeroNav, { passive: true });
        DESKTOP_MQ.addEventListener("change", () => {
          if (!DESKTOP_MQ.matches) {
            heroNav.style.transition = "";
            heroNav.style.opacity = "";
            heroNav.style.pointerEvents = "";
            heroNav.style.visibility = "";
          } else {
            updateHeroNav();
          }
        });
        updateHeroNav();

        const heroLinks = [
          ...heroNav.querySelectorAll<HTMLAnchorElement>(
            ".mm-navigation-hero__list-item a",
          ),
        ];
        const firstSideLink = sideNav.querySelector<HTMLAnchorElement>("a");

        if (heroLinks.length > 0 && firstSideLink && DESKTOP_MQ.matches) {
          heroLinks[heroLinks.length - 1].addEventListener("keydown", (e) => {
            if (e.key === "Tab" && !e.shiftKey) {
              e.preventDefault();
              window.scrollTo({ top: hero.offsetHeight, behavior: "smooth" });
              sideNav.classList.add("--scrolled");
              mainEl.classList.add("--scrolled");
              firstSideLink.focus({ preventScroll: true });
            }
          });
        }
      }

      // Fade side nav out when footer enters viewport
      const footerEl = document.querySelector<HTMLElement>("footer");
      if (sideNav && footerEl) {
        const footerObserver = new IntersectionObserver(
          ([entry]) => {
            sideNav.style.opacity = entry.isIntersecting ? "0" : "";
          },
          { rootMargin: "0px 0px -200px 0px" },
        );
        footerObserver.observe(footerEl);
      }
    </script>
  </body>
</html>
