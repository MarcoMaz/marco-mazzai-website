---
import Footer from "../components/organisms/Footer/Footer.astro";
import HeroSection from "../components/organisms/HeroSection/HeroSection.astro";
import Navigation from "../components/organisms/Navigation/Navigation.astro";
import { PAGE_TITLES, META } from "../content.config";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "../styles/global.scss";
import tankerWoff2 from "../assets/fonts/tanker/Tanker-Regular.woff2";

interface BaseLayoutProps {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = META.description,
  image = META.og.image,
  type = META.og.type,
} = Astro.props as BaseLayoutProps;

const pageTitle = PAGE_TITLES.default;
const metaTitle = title ?? META.title;

const isHome = Astro.url.pathname === "/";

const { keywords, og: { locale: ogLocale } } = META;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(image, siteOrigin);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      href={tankerWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title ?? pageTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-512x512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO + Social Meta -->
    <meta name="keywords" content={keywords} />
    <meta name="description" content={description} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content={type} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <Navigation isHome={isHome} />
    <HeroSection />
    <main class:list={[{ "--scrolled": !isHome }]}>
      <slot />
    </main>
    <Footer />
    <script>
      // Toggle hero nav out and side nav in when hero scrolls out of view
      const hero = document.querySelector<HTMLElement>(".mm-hero");
      const heroNav = document.querySelector<HTMLElement>(
        ".mm-navigation-desktop__hero-list",
      );
      const sideNav = document.querySelector<HTMLElement>(
        ".mm-navigation-desktop__side",
      );
      const mainEl = document.querySelector<HTMLElement>("main");

      const DESKTOP_MQ = window.matchMedia("(min-width: 1024px)");

      if (hero && heroNav && sideNav && mainEl) {
        // Cached instead of read on every scroll event, since reading it
        // right after the previous frame's style writes forces a synchronous
        // reflow. Kept in sync via ResizeObserver instead.
        let heroHeight = hero.offsetHeight;
        new ResizeObserver(() => {
          heroHeight = hero.offsetHeight;
        }).observe(hero);

        // Hero nav opacity tied 1:1 to scroll progress through the hero
        // (desktop only, runs every frame while scrolling).
        let scrollRaf = 0;
        const updateHeroNav = () => {
          if (!DESKTOP_MQ.matches) return;
          const ratio = Math.max(0, 1 - window.scrollY / heroHeight);
          heroNav.style.transition = "none";
          heroNav.style.opacity = String(ratio);
          heroNav.style.pointerEvents = ratio > 0 ? "" : "none";
        };

        // Side nav/main "--scrolled" state only reflects the *settled* scroll
        // position, not every intermediate frame: our own Tab-trap handlers
        // scroll the page programmatically and set this class synchronously
        // themselves (see below) so focus can land correctly mid-animation —
        // recomputing it on every frame would fight that and revert it while
        // the animated scroll is still in flight. Not an IntersectionObserver
        // either: Chromium stops firing IntersectionObserver callbacks for the
        // rest of the page's life after a single `scrollTo({ behavior:
        // "smooth" })` call, which we trigger ourselves in those same
        // handlers — that left the side nav stuck open after any later scroll.
        let settleTimer = 0;
        const updateScrolledState = () => {
          if (!DESKTOP_MQ.matches) return;
          const scrolled = window.scrollY >= heroHeight;
          sideNav.classList.toggle("--scrolled", scrolled);
          mainEl.classList.toggle("--scrolled", scrolled);
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!scrollRaf) {
              scrollRaf = requestAnimationFrame(() => {
                scrollRaf = 0;
                updateHeroNav();
              });
            }
            window.clearTimeout(settleTimer);
            settleTimer = window.setTimeout(updateScrolledState, 100);
          },
          { passive: true },
        );
        DESKTOP_MQ.addEventListener("change", () => {
          if (!DESKTOP_MQ.matches) {
            heroNav.style.transition = "";
            heroNav.style.opacity = "";
            heroNav.style.pointerEvents = "";
          } else {
            updateHeroNav();
          }
          updateScrolledState();
        });

        // Shift+Tab back into the hero nav: scroll to top so it becomes visible
        heroNav.addEventListener("focusin", () => {
          if (DESKTOP_MQ.matches && window.scrollY > 0) {
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });
        if (window.location.pathname !== "/") {
          window.scrollTo({ top: heroHeight, behavior: "instant" });
        }
        updateHeroNav();
        updateScrolledState();

        const heroLinks = [
          ...heroNav.querySelectorAll<HTMLAnchorElement>(
            ".mm-navigation-desktop__hero-list-item a",
          ),
        ];
        const firstSideLink = sideNav.querySelector<HTMLAnchorElement>("a");

        if (heroLinks.length > 0 && firstSideLink && DESKTOP_MQ.matches) {
          heroLinks[heroLinks.length - 1].addEventListener("keydown", (e) => {
            if (e.key === "Tab" && !e.shiftKey) {
              e.preventDefault();
              window.scrollTo({ top: heroHeight, behavior: "smooth" });
              // Side nav is visibility:hidden until "--scrolled" is set, and a
              // hidden element can't take focus — updateScrolledState() is
              // debounced until scrolling settles, so it's set here
              // synchronously, immediately before focus() is called.
              sideNav.classList.add("--scrolled");
              mainEl.classList.add("--scrolled");
              firstSideLink.focus({ preventScroll: true });
            }
          });
        }
      }

      // Fade side nav out when footer enters viewport
      const footerEl = document.querySelector<HTMLElement>("footer");
      if (sideNav && footerEl) {
        const footerObserver = new IntersectionObserver(
          ([entry]) => {
            sideNav.style.opacity = entry.isIntersecting ? "0" : "";
          },
          { rootMargin: "0px 0px -200px 0px" },
        );
        footerObserver.observe(footerEl);
      }
    </script>
  </body>
</html>
